# Application
PORT=8000
APP_MODE=development
NODE_ENV=development

# Login (or use auth.config.json — see auth.config.example.json)
AUTH_USERNAME=you@example.com
AUTH_PASSWORD=your_password
AUTH_SESSION_TTL_MS=604800000

# Database (optional — without MongoDB the app uses in-memory cache)
DB_USERNAME=user
DB_PASSWORD=demo1
MONGODB_URI=mongodb://user:demo1@localhost:27017/mailshot?authSource=admin

# IMAP (incoming mail sync)
MAIL_IMAP_HOST=mailshot.tensology.com
MAIL_IMAP_PORT=993
MAILBOX_USER=paul@mailshot.tensology.com
MAILBOX_PASSWORD=your_mailbox_password

# SMTP (outgoing mail)
MAIL_SMTP_HOST=mailshot.tensology.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_REJECT_UNAUTHORIZED=false
MAIL_FROM=Paul@Tensology.com
MAIL_NAME=Paul

# Sync
MAILBOX_SYNC_ENABLED=true
MAILBOX_POLL_INTERVAL_MS=30000

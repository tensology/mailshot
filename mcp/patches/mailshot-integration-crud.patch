+/** Look up one record without the read-marking side effect of getEmailById. */
+export const createRecordLookup = ({
+    storeReady = isMailboxStoreReady,
+    repository = getMailboxRepository,
+    findRecord = findEmailRecord
+} = {}) => async (id) => {
